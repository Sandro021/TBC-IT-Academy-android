<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph.xml"
    app:startDestination="@id/logInFragment">

    <fragment
        android:id="@+id/connectionsFragment"
        android:name="com.example.challenge.presentation.screen.connection.ConnectionsFragment"
        android:label="fragment_connections"
        tools:layout="@layout/fragment_connections" >
        <action
            android:id="@+id/action_connectionsFragment_to_logInFragment"
            app:destination="@id/logInFragment" />
    </fragment>
    <fragment
        android:id="@+id/logInFragment"
        android:name="com.example.challenge.presentation.screen.log_in.LogInFragment"
        android:label="fragment_log_in"
        tools:layout="@layout/fragment_log_in" >
        <action
            android:id="@+id/action_logInFragment_to_connectionsFragment"
            app:destination="@id/connectionsFragment" />
    </fragment>
    <activity
        android:id="@+id/mainActivity"
        android:name="com.example.challenge.presentation.MainActivity"
        android:label="MainActivity" />
</navigation>